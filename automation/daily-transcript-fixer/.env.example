# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Slack (bot token + chat.postMessage) ---
# Create a Slack app, add the `chat:write` bot scope, install to workspace,
# then copy the "Bot User OAuth Token" (starts with xoxb-).
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# Channel ID (e.g. C0123ABCD) or #channel-name the bot has been invited to.
SLACK_CHANNEL=#voice-claude-bots

# --- Optional overrides ---
# REPO_DIR=/Users/nithiinkathiresan/Development/Assistant/voice-claude-transcript-based-fixes
# BASE_BRANCH=main
# LOOKBACK_MIN=1440          # how far back to scan transcripts (minutes)
# MAX_TURNS=60               # safety cap on the agent
# CLAUDE_MODEL=              # empty = account default; or e.g. claude-opus-4-8
# SESSION_GLOB=*Development-Assistant-voice-claude*
