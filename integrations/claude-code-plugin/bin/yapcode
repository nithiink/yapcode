#!/usr/bin/env bash
# yapcode — start a Claude Code session that is VOICE-READY from the start,
# then attach your terminal to it. Use this instead of `claude` when you want the
# voice agent to be able to co-drive the session.
#
# Why a launcher: yapcode's hooks (permission prompts, turn-complete signals)
# can only be installed when `claude` is launched. Starting the session through the
# backend wires those hooks in; this script then drops you into the same tmux
# session so you type normally — and /voice-handoff can later flip voice on with no
# restart.
#
# Config (env): YAPCODE_URL (default http://localhost:8000), YAPCODE_TOKEN.
# Usage: yapcode [project_dir]   (defaults to the current directory)
set -euo pipefail

URL="${YAPCODE_URL:-http://localhost:8000}"
CWD="${1:-$(pwd)}"

hdr=(-H "Content-Type: application/json")
[ -n "${YAPCODE_TOKEN:-}" ] && hdr+=(-H "X-VC-Token: ${YAPCODE_TOKEN}")

req="$(CWD="$CWD" python3 -c \
  'import json,os; print(json.dumps({"name":"start_session","arguments":{"project_path":os.environ["CWD"]}}))')"

resp="$(curl -fsS -X POST "$URL/tools/execute" "${hdr[@]}" -d "$req")" || {
  echo "yapcode: couldn't reach the backend at $URL (is it running?)" >&2
  exit 1
}

sid="$(printf '%s' "$resp" | python3 -c \
  'import sys,json; d=json.load(sys.stdin); r=d.get("result",d); print(r.get("session_id",""))' \
  2>/dev/null || true)"

if [ -z "$sid" ]; then
  echo "yapcode: failed to start session: $resp" >&2
  exit 1
fi

pane="vc_${sid:0:8}"
echo "yapcode: session ready ($pane). Open the voice app to talk; attaching now…" >&2
exec tmux attach -t "$pane"
