#!/usr/bin/env bash
# voice-claude — umbrella launcher.
#
#   voice-claude up           First-run setup wizard (if needed), then start the
#                             backend + frontend and open the app in the browser.
#   voice-claude session [d]  Start + attach a voice-ready Claude session
#                             (delegates to the Claude Code plugin launcher).
#   voice-claude config       Open the config file in your editor.
#
# Config lives at ~/.config/voice-claude/.env (chmod 600) and is the SINGLE
# SOURCE OF TRUTH. The wizard only runs when that file is absent; every later
# change is an edit of that file, so subsequent runs never prompt. Edit it by
# hand, or run `voice-claude config`.
set -euo pipefail

# APP_ROOT is the installed source tree. The Homebrew wrapper exports
# VOICE_CLAUDE_ROOT; a `git clone` user running ./bin/voice-claude falls back to
# the repo root (this file's parent's parent).
APP_ROOT="${VOICE_CLAUDE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# Config dir lives OUTSIDE the source tree (and outside the Homebrew cellar), so
# `brew upgrade` / `git pull` never touch it.
CONF_DIR="${VOICE_CLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/voice-claude}"
ENV_FILE="$CONF_DIR/.env"

err() { printf '%s\n' "$*" >&2; }

# --- small input helpers ----------------------------------------------------
# read prompts go to stderr (bash does this for -p), so stdout stays clean for
# command substitution to capture the answer.

prompt_default() { # prompt_default "Question" "default" -> echoes answer
  local q="$1" def="${2:-}" ans=""
  if [ -n "$def" ]; then
    read -rp "$q [$def]: " ans || true
  else
    read -rp "$q: " ans || true
  fi
  printf '%s' "${ans:-$def}"
}

read_secret() { # read_secret "Prompt" -> echoes secret, never echoes keystrokes
  local q="$1" s=""
  read -rsp "$q: " s || true
  printf '\n' >&2
  printf '%s' "$s"
}

gen_token() { # cryptographically-strong, URL-safe
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
  elif command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr -d '/+=\n'
  else
    err "voice-claude: need python3 or openssl to generate VC_AUTH_TOKEN"; exit 1
  fi
}

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

# All roots must exist and none may be the whole home dir or filesystem root —
# this is the agent's command-execution sandbox, so being strict here matters.
validate_roots() { # validate_roots "a,b" -> 0 if all OK
  local roots="$1" ok=1 r oldifs="$IFS"
  IFS=','
  for r in $roots; do
    IFS="$oldifs"
    r="$(trim "$r")"
    case "$r" in
      ""|/|"$HOME") err "  '$r' is empty or too broad — pick a specific project folder"; ok=0 ;;
      *) [ -d "$r" ] || { err "  '$r' does not exist"; ok=0; } ;;
    esac
    IFS=','
  done
  IFS="$oldifs"
  [ "$ok" -eq 1 ]
}

# --- first-run wizard -------------------------------------------------------

run_wizard() {
  err "voice-claude — first-run setup"
  err "Writes $ENV_FILE (chmod 600). Edit that file anytime; it's the source of truth."
  err ""

  local provider
  while :; do
    provider="$(prompt_default "Voice provider (openai/azure/gemini)" "openai")"
    case "$provider" in openai|azure|gemini) break ;; *) err "  type openai, azure, or gemini" ;; esac
  done

  local openai_key="" gemini_key="" az_endpoint="" az_key="" az_deploy=""
  case "$provider" in
    openai)
      openai_key="$(read_secret "OpenAI API key (sk-...)")" ;;
    gemini)
      gemini_key="$(read_secret "Gemini API key (from https://aistudio.google.com/apikey)")" ;;
    azure)
      az_endpoint="$(prompt_default "Azure OpenAI endpoint (https://<resource>.openai.azure.com)" "")"
      az_deploy="$(prompt_default  "Azure realtime deployment name" "")"
      az_key="$(read_secret        "Azure OpenAI API key")" ;;
  esac

  local roots
  while :; do
    roots="$(prompt_default "Folder(s) the agent may edit (comma-separated)" "$HOME/Development")"
    roots="${roots/#\~/$HOME}" # expand a leading ~
    validate_roots "$roots" && break
  done

  local token; token="$(gen_token)"

  mkdir -p "$CONF_DIR"
  # umask 077 => the file is created 0600 from the start, so the secret is never
  # briefly world-readable; chmod 600 afterwards is belt-and-suspenders.
  ( umask 077; cat > "$ENV_FILE" <<EOF
# voice-claude config — generated by first-run setup. This file is the single
# source of truth; edit it freely (or run \`voice-claude config\`).
VOICE_PROVIDER=$provider
REALTIME_VOICE=marin

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=$az_endpoint
AZURE_OPENAI_API_KEY=$az_key
AZURE_OPENAI_DEPLOYMENT=$az_deploy

# --- OpenAI ---
OPENAI_API_KEY=$openai_key
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# --- Google Gemini ---
GEMINI_API_KEY=$gemini_key
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore

CLAUDE_MODEL=opus

# Folders the agent may start sessions in. Mandatory sandbox: sessions cannot
# escape these roots (realpath-resolved, containment-checked).
ALLOWED_PROJECT_ROOTS=$roots

# Shared secret for network/phone mode (auto-generated, ready to use). It is
# NOT applied on localhost — \`voice-claude up\` runs loopback-only, where no
# token is needed. It takes effect only when you expose the backend with
# backend/run-network.sh (0.0.0.0). See README "LAN / phone (network mode)".
VC_AUTH_TOKEN=$token
EOF
  )
  chmod 600 "$ENV_FILE"
  err ""
  err "✓ Wrote $ENV_FILE  (provider=$provider, roots=$roots)"
  err "  Generated a VC_AUTH_TOKEN for later network/phone use."
}

ensure_env() { [ -f "$ENV_FILE" ] || run_wizard; }

# --- one-time dependency bootstrap (no-op once set up) ----------------------

bootstrap() {
  if [ ! -x "$APP_ROOT/backend/.venv/bin/python" ]; then
    err "Setting up the Python backend (first run)…"
    python3 -m venv "$APP_ROOT/backend/.venv"
    "$APP_ROOT/backend/.venv/bin/pip" install -q -r "$APP_ROOT/backend/requirements.txt"
  fi
  if [ ! -d "$APP_ROOT/frontend/node_modules" ]; then
    err "Installing frontend dependencies (first run)…"
    ( cd "$APP_ROOT/frontend" && npm ci )
  fi
}

# --- subcommands ------------------------------------------------------------

cmd_up() {
  ensure_env
  bootstrap

  # Load the canonical config into the environment. python-dotenv (override
  # defaults to False) defers to real env vars, so these win over any stale
  # backend/.env. Then drop VC_AUTH_TOKEN: on localhost, setting it would force
  # even loopback callers to present the token (per the access-control model),
  # breaking the zero-config localhost flow. It stays in the file for run-network.
  set -a; . "$ENV_FILE"; set +a
  unset VC_AUTH_TOKEN

  ( cd "$APP_ROOT/backend" && exec .venv/bin/python -m uvicorn main:app --port 8000 --log-level info ) &
  local back=$!

  # Prefer the production server when a build exists (Homebrew install builds it);
  # fall back to dev for a plain git clone.
  local fe_cmd="dev"
  [ -d "$APP_ROOT/frontend/.next" ] && fe_cmd="start"
  ( cd "$APP_ROOT/frontend" && exec npm run "$fe_cmd" ) >/dev/null 2>&1 &
  local front=$!

  trap 'kill "$back" "$front" 2>/dev/null || true' INT TERM EXIT
  err "voice-claude: starting (backend :8000, frontend :3000)…"
  local i
  for i in $(seq 1 60); do curl -fsS http://localhost:3000 >/dev/null 2>&1 && break; sleep 0.5; done
  if command -v open >/dev/null 2>&1; then open http://localhost:3000 || true; else err "Open http://localhost:3000"; fi
  err "voice-claude: running. Press Ctrl-C to stop both servers."
  wait
}

cmd_session() {
  ensure_env
  set -a; . "$ENV_FILE"; set +a
  export VOICE_CLAUDE_TOKEN="${VC_AUTH_TOKEN:-}" # the plugin launcher reads this
  exec "$APP_ROOT/integrations/claude-code-plugin/bin/voice-claude" "$@"
}

cmd_config() {
  ensure_env
  err "$ENV_FILE"
  "${EDITOR:-open}" "$ENV_FILE" 2>/dev/null || err "Open it in your editor: $ENV_FILE"
}

case "${1:-up}" in
  up)       cmd_up ;;
  session)  shift; cmd_session "$@" ;;
  config)   cmd_config ;;
  -h|--help|help) err "usage: voice-claude {up|session [dir]|config}" ;;
  *)        err "usage: voice-claude {up|session [dir]|config}"; exit 2 ;;
esac
