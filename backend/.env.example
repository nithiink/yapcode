# Default voice provider when the UI doesn't override it:
#   "azure" | "openai" | "gemini". The provider can also be switched live from
#   the UI toggle. Whichever is used, the API key stays server-side.
VOICE_PROVIDER=azure
REALTIME_VOICE=marin

# --- Azure OpenAI (GA realtime, WebRTC) ---
# Resource must have a realtime model deployed in East US 2 or Sweden Central.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_DEPLOYMENT=<your-realtime-deployment-name>

# --- OpenAI direct (WebRTC; used when provider=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# --- Google Gemini Live (WebSocket; used when provider=gemini) ---
# Get a key at https://aistudio.google.com/apikey . The browser only ever sees a
# short-lived ephemeral token minted from this key server-side.
GEMINI_API_KEY=
# Cheapest viable native-audio model. Best quality: gemini-3.1-flash-live-preview
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore

# Claude execution (Agent SDK). Uses the existing Claude Code login (Max 20x) —
# no Anthropic API key needed. Opus is on-subscription until 2026-06-15.
CLAUDE_MODEL=opus

# Comma-separated default project dir(s) the voice agent may start sessions in.
# Used to validate start_session paths.
ALLOWED_PROJECT_ROOTS=/Users/nithiinkathiresan/Development

# On backend shutdown, kill interactive CLI sessions instead of leaving them
# running. Default (unset): detach — sessions survive a restart and are
# rehydrated on the next startup. Set to 1 to restore the old destroy-on-exit
# behavior (stopping the backend kills every CLI session).
# VC_KILL_SESSIONS_ON_SHUTDOWN=0

# Where interactive CLI session control dirs (meta.json, events.jsonl, mode,
# settings.json, decisions/) are stored — the storage rehydration reads.
# Defaults to <project>/.voice-claude/tmux (gitignored). Point it elsewhere,
# e.g. ~/.voice-claude/tmux, if you'd rather keep it outside the repo.
# VC_SESSION_STORE=
